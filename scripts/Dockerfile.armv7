# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM debian:bullseye-slim@sha256:e5b6442dd2e9684cf5e87d8338b5968f3b348636fc0be6d7850a381e3731a2bd
COPY scripts/toolchain-packages.lock /tmp/toolchain-packages.lock
RUN --mount=type=secret,id=proxy_ca,target=/run/proxy-ca.pem,mode=0444,required=true \
    printf 'deb https://deb.debian.org/debian bullseye main\n' > /etc/apt/sources.list && \
    apt-get -o Acquire::https::CaInfo=/run/proxy-ca.pem update && \
    apt-get -o Acquire::https::CaInfo=/run/proxy-ca.pem install -y --no-install-recommends \
      $(cat /tmp/toolchain-packages.lock) && \
    dpkg-query -W > /toolchain-packages.txt && rm -rf /var/lib/apt/lists/*
WORKDIR /project
